
<Window x:Class="EasySave.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:EasySave.GUI.ViewModels"
        xmlns:views="clr-namespace:EasySave.GUI.Views"
        Title="{DynamicResource AppTitle}"
        Height="720"
        Width="1280"
        MinHeight="650"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow">

 

    <Window.Resources>
<DataTemplate DataType="{x:Type viewModels:JobListViewModel}">
<views:JobListView />
</DataTemplate>

 

        <DataTemplate DataType="{x:Type viewModels:JobHistoryViewModel}">
<views:JobHistoryView />
</DataTemplate>

 

        <DataTemplate DataType="{x:Type viewModels:JobEditViewModel}">
<views:JobEditView />
</DataTemplate>

 

        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
<views:SettingsView />
</DataTemplate>

 

        <DataTemplate DataType="{x:Type viewModels:JobExecutionViewModel}">
<views:JobExecutionView />
</DataTemplate>
</Window.Resources>

 

    <Grid Background="{StaticResource AppBackgroundBrush}">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="260" />
<ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>

 

        <!-- LEFT SIDEBAR -->
<Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">
<DockPanel Margin="20">

 

                <StackPanel DockPanel.Dock="Top">
<TextBlock Text="{DynamicResource AppTitle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,18,0,4" />

 

                    <TextBlock Text="{DynamicResource AppSubtitle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,0,38" />

 

                    <Button Content="{DynamicResource NavBackupJobs}"
                            Style="{StaticResource SelectedNavButtonStyle}"
                            Command="{Binding ShowJobsCommand}" />

 

                    <Button Content="{DynamicResource NavHistory}"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowHistoryCommand}" />

 

                    <Button Content="{DynamicResource NavCreateJob}"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowCreateJobCommand}" />

 

                    <Button Content="{DynamicResource NavSettings}"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowSettingsCommand}" />

 

                    <Button Content="{DynamicResource NavExecution}"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowExecutionCommand}" />
</StackPanel>

 

                <StackPanel DockPanel.Dock="Bottom">
<Border Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,0,0,18" />

 

                    <TextBlock Text="{DynamicResource AppFooterCompatibility}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,0,0,4" />

 

                    <TextBlock Text="{DynamicResource AppFooterVersion}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" />
</StackPanel>

 

            </DockPanel>
</Border>

 

        <!-- MAIN AREA -->
<Grid Grid.Column="1"
              Margin="26">
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
</Grid.RowDefinitions>

 

            <!-- TOP HEADER CARD -->
<Border Grid.Row="0"
                    Style="{StaticResource CardBorderStyle}"
                    Margin="0,0,0,20">
<StackPanel>
<TextBlock Text="{DynamicResource AppTitle}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

 

                    <TextBlock Text="{DynamicResource AppHeaderDescription}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               Margin="0,6,0,0" />
</StackPanel>
</Border>

 

            <!-- CONTENT -->
<Border Grid.Row="1"
                    Style="{StaticResource CardBorderStyle}">
<ContentControl Content="{Binding CurrentView}" />
</Border>
</Grid>
</Grid>
</Window>

