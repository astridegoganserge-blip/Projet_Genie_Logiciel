
<UserControl x:Class="EasySave.GUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

 

    <Grid Margin="24">
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>

 

        <!-- TITLE -->
<StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">
<TextBlock Text="⚙"
                       FontSize="28"
                       Foreground="{StaticResource AccentLightBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

 

            <StackPanel>
<TextBlock Text="{DynamicResource SettingsTitle}"
                           Style="{StaticResource PageTitleStyle}" />

 

                <TextBlock Text="{DynamicResource SettingsSubtitle}"
                           Style="{StaticResource SecondaryTextStyle}" />
</StackPanel>
</StackPanel>

 

        <!-- CONTENT -->
<ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
<StackPanel>

 

                <!-- LANGUAGE -->
<Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16">
<StackPanel>
<TextBlock Text="{DynamicResource SettingsLanguage}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12" />

 

                        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource ReadableComboBoxStyle}" />
</StackPanel>
</Border>

 

                <!-- LOG FORMAT -->
<Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16">
<StackPanel>
<TextBlock Text="{DynamicResource SettingsLogFormat}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12" />

 

                        <ComboBox ItemsSource="{Binding AvailableFormats}"
                                  SelectedItem="{Binding SelectedLogFormat, Mode=TwoWay}"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource ReadableComboBoxStyle}" />

 

                        <TextBlock Text="{DynamicResource SettingsLogFormatHint}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0" />
</StackPanel>
</Border>

 

                <!-- LOG MODE -->
<Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16">
<StackPanel>
<TextBlock Text="{DynamicResource SettingsLogMode}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12" />

 

                        <ComboBox ItemsSource="{Binding AvailableLogModes}"
                                  SelectedItem="{Binding SelectedLogMode, Mode=TwoWay}"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource ReadableComboBoxStyle}" />

 

                        <StackPanel Margin="0,14,0,0">
<StackPanel.Style>
<Style TargetType="StackPanel">
<Setter Property="Visibility" Value="Collapsed" />
<Style.Triggers>
<DataTrigger Binding="{Binding ShowDockerUrl}" Value="True">
<Setter Property="Visibility" Value="Visible" />
</DataTrigger>
</Style.Triggers>
</Style>
</StackPanel.Style>

 

                            <TextBlock Text="{DynamicResource SettingsDockerUrl}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />

 

                            <TextBox Text="{Binding DockerLogServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Width="420"
                                     HorizontalAlignment="Left" />

 

                            <TextBlock Text="{DynamicResource SettingsDockerExample}"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,6,0,0" />
</StackPanel>
</StackPanel>
</Border>

 

                <!-- BUSINESS SOFTWARE -->
<Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16">
<StackPanel>
<TextBlock Text="{DynamicResource SettingsBusinessSoftware}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12" />

 

                        <TextBox Text="{Binding BusinessSoftware, UpdateSourceTrigger=PropertyChanged}"
                                 Width="300"
                                 HorizontalAlignment="Left" />

 

                        <TextBlock Text="{DynamicResource SettingsBusinessSoftwareHint}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0" />
</StackPanel>
</Border>

 

                <!-- MAX LARGE FILE SIZE -->
<Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16">
<StackPanel>
<TextBlock Text="{DynamicResource SettingsMaxFileSize}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12" />

 

                        <StackPanel Orientation="Horizontal">
<TextBox Text="{Binding MaxFileSizeKb, UpdateSourceTrigger=PropertyChanged}"
                                     Width="160"
                                     Margin="0,0,10,0" />

 

                            <TextBlock Text="{DynamicResource SettingsKb}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
</StackPanel>

 

                        <TextBlock Text="{DynamicResource SettingsMaxFileSizeHint}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0" />
</StackPanel>
</Border>

 

                <!-- EXTENSIONS TO ENCRYPT -->
<Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="180" />
</Grid.RowDefinitions>

 

                        <TextBlock Grid.Row="0"
                                   Text="{DynamicResource SettingsExtensions}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12" />

 

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12">
<TextBox Text="{Binding NewExtensionInput, UpdateSourceTrigger=PropertyChanged}"
                                     Width="180"
                                     Margin="0,0,10,0" />

 

                            <Button Content="{DynamicResource BtnAdd}"
                                    Width="100"
                                    Command="{Binding AddExtensionCommand}" />
</StackPanel>

 

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding ExtensionsToEncrypt}">
<ListBox.ItemTemplate>
<DataTemplate>
<DockPanel Margin="0,4">
<Button Content="{DynamicResource BtnRemove}"
                                                DockPanel.Dock="Right"
                                                Width="110"
                                                Height="30"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />

 

                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
</DockPanel>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</Grid>
</Border>

 

                <!-- PRIORITY EXTENSIONS -->
<Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,16">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="180" />
</Grid.RowDefinitions>

 

                        <TextBlock Grid.Row="0"
                                   Text="{DynamicResource SettingsPriorityExtensions}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12" />

 

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,12">
<TextBox Text="{Binding NewPriorityExtensionInput, UpdateSourceTrigger=PropertyChanged}"
                                     Width="180"
                                     Margin="0,0,10,0" />

 

                            <Button Content="{DynamicResource BtnAdd}"
                                    Width="100"
                                    Command="{Binding AddPriorityExtensionCommand}" />
</StackPanel>

 

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding PriorityExtensions}">
<ListBox.ItemTemplate>
<DataTemplate>
<DockPanel Margin="0,4">
<Button Content="{DynamicResource BtnRemove}"
                                                DockPanel.Dock="Right"
                                                Width="110"
                                                Height="30"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.RemovePriorityExtensionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />

 

                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
</DockPanel>
</DataTemplate>
</ListBox.ItemTemplate>
</ListBox>
</Grid>
</Border>

 

            </StackPanel>
</ScrollViewer>

 

        <!-- FOOTER -->
<Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,18,0,0"
                Padding="0,14,0,0">
<DockPanel>
<Button Content="{DynamicResource SettingsSave}"
                        Width="150"
                        Style="{StaticResource SuccessButtonStyle}"
                        Command="{Binding SaveCommand}"
                        DockPanel.Dock="Left"
                        Margin="0,0,14,0" />

 

                <StackPanel Orientation="Horizontal">
<TextBlock Text="{Binding SuccessMessage}"
                               Foreground="{StaticResource SuccessBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

 

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
</StackPanel>
</DockPanel>
</Border>
</Grid>
</UserControl>

