<UserControl x:Class="EasySave.GUI.Views.JobExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EasySave.GUI.Converters">

 

    <UserControl.Resources>
<converters:StatusColorConverter x:Key="StatusColorConverter" />
</UserControl.Resources>

 

    <Grid Margin="24">
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>

 

        <!-- TITLE -->
<StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">
<TextBlock Text="↻"
                       FontSize="28"
                       Foreground="{StaticResource AccentLightBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

 

            <StackPanel>
<TextBlock Text="{DynamicResource ExecutionTitle}"
                           Style="{StaticResource PageTitleStyle}" />

 

                <TextBlock Text="{DynamicResource ExecutionSubtitle}"
                           Style="{StaticResource SecondaryTextStyle}" />
</StackPanel>
</StackPanel>

 

        <!-- MONITORING ACTIONS -->
<Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,18">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>

 

                <WrapPanel Grid.Row="0"
                           Margin="0,0,0,16">
<Button Content="{DynamicResource BtnStartMonitoring}"
                            Width="160"
                            Margin="0,0,10,10"
                            Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding StartMonitoringCommand}" />

 

                    <Button Content="{DynamicResource BtnStopMonitoring}"
                            Width="160"
                            Margin="0,0,10,10"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding StopMonitoringCommand}" />
</WrapPanel>

 

                <TextBlock Grid.Row="1"
                           Text="{Binding MonitoringStatus}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,8" />

 

                <StackPanel Grid.Row="2">
<ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="22"
                                 Value="{Binding GlobalProgression}" />

 

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">
<TextBlock Text="{DynamicResource ExecutionProgress}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" />

 

                        <TextBlock Text=" : "
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" />

 

                        <TextBlock Text="{Binding GlobalProgression, StringFormat={}{0}%}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" />
</StackPanel>
</StackPanel>
</Grid>
</Border>

 

        <!-- STATES TABLE -->
<Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
<DataGrid ItemsSource="{Binding JobStates}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True">
<DataGrid.Columns>

 

                    <DataGridTextColumn Header="{DynamicResource ExecutionBackup}"
                                        Binding="{Binding BackupName}"
                                        Width="2*" />

 

                    <DataGridTemplateColumn Header="{DynamicResource ExecutionStatus}"
                                            Width="140">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock Text="{Binding Status}"
                                           Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>

 

                    <DataGridTemplateColumn Header="{DynamicResource ExecutionProgress}"
                                            Width="180">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<StackPanel>
<ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Height="16"
                                                 Value="{Binding Progression}" />

 

                                    <TextBlock Text="{Binding Progression, StringFormat={}{0}%}"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Margin="0,4,0,0" />
</StackPanel>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>

 

                    <DataGridTextColumn Header="{DynamicResource ExecutionRemainingFiles}"
                                        Binding="{Binding RemainingFiles}"
                                        Width="140" />

 

                    <DataGridTextColumn Header="{DynamicResource ExecutionRemainingSize}"
                                        Binding="{Binding RemainingSize}"
                                        Width="140" />

 

                    <DataGridTextColumn Header="{DynamicResource ExecutionCurrentSource}"
                                        Binding="{Binding CurrentSourceFile}"
                                        Width="3*" />

 

                    <DataGridTextColumn Header="{DynamicResource ExecutionCurrentTarget}"
                                        Binding="{Binding CurrentTargetFile}"
                                        Width="3*" />

 

                </DataGrid.Columns>
</DataGrid>
</Border>

 

        <!-- INFO -->
<Border Grid.Row="3"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,18,0,0"
                Padding="0,14,0,0">
<TextBlock Text="{DynamicResource ExecutionInfo}"
                       Style="{StaticResource SecondaryTextStyle}" />
</Border>
</Grid>
</UserControl>